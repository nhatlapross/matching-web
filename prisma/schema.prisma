generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  passwordHash        String?
  image               String?
  profileComplete     Boolean   @default(false)
  role                Role      @default(MEMBER)
  profileObjectId     String?
  walletAddress       String?
  publicAvatarBlobId  String?
  privateAvatarBlobId String?
  avatarSealPolicyId  String?
  avatarUploadedAt    DateTime?
  avatarSettings      Json      @default("{}")
  accounts            Account[]
  member              Member?
}

model Member {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  name                    String
  gender                  String
  dateOfBirth             DateTime
  created                 DateTime  @default(now())
  updated                 DateTime  @default(now())
  description             String
  city                    String
  country                 String
  image                   String?
  faceVerificationEnabled Boolean   @default(false)
  referenceFaceLandmarks  Json?
  referenceFaceUploadedAt DateTime?
  referenceFaceUrl        String?
  interests               String[]  @default([])
  sourceLikes             Like[]    @relation("source")
  targetLikes             Like[]    @relation("target")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientMessages       Message[] @relation("recipient")
  senderMessages          Message[] @relation("sender")
  photos                  Photo[]
}

model Photo {
  id                    String    @id @default(cuid())
  url                   String
  publicId              String?
  memberId              String
  isApproved            Boolean   @default(false)
  faceLandmarks         Json?
  faceVerificationScore Float?
  faceVerified          Boolean   @default(false)
  verifiedAt            DateTime?
  member                Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Like {
  sourceUserId String
  targetUserId String
  createdAt    DateTime @default(now())
  matchId      String?
  matchStatus  Int      @default(0)
  sourceMember Member   @relation("source", fields: [sourceUserId], references: [userId], onDelete: Cascade)
  targetMember Member   @relation("target", fields: [targetUserId], references: [userId], onDelete: Cascade)

  @@id([sourceUserId, targetUserId])
}

model ChatRoom {
  id              String   @id @default(cuid())
  chatRoomId      String   @unique
  chatAllowlistId String
  participant1    String
  participant2    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([participant1, participant2])
  @@index([chatRoomId])
}

model Message {
  id               String    @id @default(cuid())
  text             String
  created          DateTime  @default(now())
  senderId         String?
  recipientId      String?
  dateRead         DateTime?
  senderDeleted    Boolean   @default(false)
  recipientDeleted Boolean   @default(false)
  recipient        Member?   @relation("recipient", fields: [recipientId], references: [userId])
  sender           Member?   @relation("sender", fields: [senderId], references: [userId])
}

model Token {
  id      String    @id @default(cuid())
  email   String
  token   String
  expires DateTime
  type    TokenType

  @@unique([email, token])
}

model AvatarUploadMetric {
  id                String   @id @default(cuid())
  userId            String
  timestamp         DateTime @default(now())
  fileSize          Int
  originalFormat    String
  processedFormats  String[] @default([])
  processingTime    Int
  success           Boolean
  errorCode         String?
  errorMessage      String?
  compressionRatio  Float?
  variantsGenerated Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([userId, timestamp])
  @@index([timestamp])
  @@index([success])
}

model AvatarAccessMetric {
  id           String   @id @default(cuid())
  targetUserId String
  viewerUserId String?
  timestamp    DateTime @default(now())
  avatarType   String
  isEncrypted  Boolean
  hasAccess    Boolean
  loadTime     Int?
  cacheHit     Boolean  @default(false)
  userAgent    String?
  referrer     String?
  errorCode    String?
  createdAt    DateTime @default(now())

  @@index([targetUserId, timestamp])
  @@index([viewerUserId, timestamp])
  @@index([timestamp])
  @@index([avatarType])
}

model AvatarEngagementMetric {
  id        String   @id @default(cuid())
  userId    String
  action    String
  timestamp DateTime @default(now())
  sessionId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, timestamp])
  @@index([timestamp])
  @@index([action])
}

enum TokenType {
  VERIFICATION
  PASSWORD_RESET
}

enum Role {
  ADMIN
  MEMBER
}
